APP_NAME=Vayla
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Back-office sur sous-domaine dédié
OFFICE_DOMAIN=office.localhost
OFFICE_URL=http://office.localhost:8070

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=vayla

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# A passer à true en production (derrière HTTPS)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` par défaut, et ce n'est pas un détail : envoyer pour de vrai doit être
# un choix explicite, jamais le résultat d'un oubli de configuration. Sans ça,
# la mise au point d'un écran part sur de vraies boîtes.
#
# Pour recevoir les codes d'inscription en développement, un bac à sable
# (Mailtrap, Mailpit…) : les messages y sont capturés, jamais remis à un vrai
# destinataire — on peut donc tester avec une adresse réelle sans écrire à
# personne. Renseigner MAIL_USERNAME / MAIL_PASSWORD depuis le bac à sable,
# **dans `.env`, jamais ici** : ce fichier est versionné.
#
#   MAIL_MAILER=smtp
#   MAIL_HOST=sandbox.smtp.mailtrap.io
#   MAIL_PORT=2525
#
# `env_file` fige le `.env` à la *création* du conteneur : après ce
# changement, `docker compose up -d --force-recreate app`, sinon la variable
# garde son ancienne valeur (voir « Pièges » dans CLAUDE.md).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Connexion sociale (Laravel Socialite) ────────────────────────────────
#
# **Valeurs vides ici, toujours.** Ce fichier est versionné. Les identifiants
# vont dans `.env`, qui ne l'est pas.
#
# Un fournisseur sans `CLIENT_ID` est **absent des écrans** et sa route répond
# 404 : c'est ce qui permet d'ouvrir Google d'abord et les autres plus tard,
# sans afficher un bouton qui mène à une erreur.
#
# Les URL de rappel doivent correspondre **au caractère près** à celles
# déclarées dans la console du fournisseur. Elles diffèrent par environnement —
# en local, HTTP et le port 8070 ; en production, HTTPS obligatoire.
#
# Où récupérer chaque identifiant, et quoi déclarer : voir
# `docs/architecture/social-auth.md`.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# Apple : `APPLE_CLIENT_SECRET` n'est pas une chaîne fixe mais un **JWT signé**
# avec la clé `.p8`, valable six mois au maximum. Il se régénère — le poser une
# fois pour toutes condamne la connexion Apple à s'arrêter sans prévenir.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/auth/apple/callback"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Annonces de démonstration : fictives, elles n'existent que pour dessiner
# la grille. À false, la grille se vide et le bandeau « Aperçu » disparaît.
VAYLA_DEMO=true

# L'hôte du back-office. Un hôte à part plutôt qu'un préfixe `/admin` : c'est
# un cookie de session à part. `*.localhost` résout vers la machine sans rien
# toucher au fichier hosts ; en production, un sous-domaine (office.vayla.mg).
VAYLA_OFFICE_DOMAIN=office.localhost

# Taux indicatif ariary → euro, et le jour où il a été relevé. L'euro n'est
# affiché qu'à côté de l'ariary, jamais seul : Vayla n'encaisse rien et le
# voyageur règle sur place en ariary.
# Le canal du code à usage unique : `log` (rien n'est envoyé, le code va dans
# storage/logs), `whatsapp` (Meta Cloud API) ou `sms` (Twilio).
# `log` par défaut : envoyer pour de vrai doit être un choix explicite, jamais
# le résultat d'un oubli — sinon la mise au point d'un écran part sur de vrais
# téléphones, et se facture.
VAYLA_OTP_DRIVER=log

# WhatsApp Cloud API. `WHATSAPP_PHONE_NUMBER_ID` est l'identifiant du numéro
# expéditeur dans le gestionnaire Meta, pas le numéro. Le modèle doit être de
# catégorie « Authentication » et approuvé avant tout envoi.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=vayla_code
WHATSAPP_OTP_LANG=fr
# Faux si votre modèle d'authentification n'a pas de bouton « copier le code » :
# envoyer le composant à un modèle qui n'en a pas fait échouer le message avec
# une erreur Meta qui ne nomme pas la cause.
WHATSAPP_OTP_COPY_BUTTON=true

# Twilio, le repli SMS. Un compte se crée sans entreprise enregistrée.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

VAYLA_EUR_RATE=5000
VAYLA_EUR_RATE_DATE=2026-09-04

# API compatible OpenAI (OpenAI, Mistral, Groq, OpenRouter, Ollama...)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30

VITE_APP_NAME="${APP_NAME}"
